# Copy to /opt/fixnest/app/server/.env on the server and fill in the <...> parts. Never commit the real file.
NODE_ENV=production
# The app listens on this port, only on the server itself; Caddy forwards the website to it.
# Pick one nothing else uses (check with: sudo ss -ltn). On a shared server 3001 may be taken.
PORT=3011

# Make a fresh secret on the server:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<paste the generated value>

# Exactly the address people type, with https and no trailing slash. Links in emails and the security checks use it.
APP_URL=https://your-domain.example
# One web server (Caddy) sits in front of the app.
TRUST_PROXY=1

DB_PATH=/var/lib/fixnest/hostel.db
UPLOAD_DIR=/var/lib/fixnest/uploads
BACKUP_DIR=/var/backups/fixnest

STUDENT_EMAIL_DOMAINS=students.isquareit.edu.in
GOOGLE_CLIENT_ID=<the same client id you use locally>

# Outgoing email (sign-up codes, password resets, notifications). Resend example:
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=<your Resend API key>
SMTP_FROM=FixNest <support@your-domain.example>
