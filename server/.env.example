# Copy to .env and adjust. Never commit .env.
PORT=3001
# Leave empty. In production the app then only accepts connections from the same machine (your web server, Caddy).
HOST=
# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# URL of the web app (browser origin allowed to call the API)
APP_URL=http://localhost:5173
DB_PATH=./hostel.db
UPLOAD_DIR=./uploads
# Comma-separated list of email domains allowed to self-register as students
STUDENT_EMAIL_DOMAINS=students.isquareit.edu.in
# Google sign-in (optional). Create an OAuth client of type "Web application" in Google Cloud Console,
# add http://localhost:5173 under Authorized JavaScript origins, and paste its client id here.
GOOGLE_CLIENT_ID=
# When the app runs behind a reverse proxy (nginx, a host's load balancer): how many proxies sit in front.
# Leave at 0 when clients connect directly.
TRUST_PROXY=0
# Outgoing email: sign-up codes, password resets, notifications. Required in production; in development,
# with SMTP_HOST empty, emails print in the server console instead. Port 465 uses SSL, 587 uses STARTTLS.
# Gmail example (needs 2-Step Verification and an App Password from https://myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=yourname@gmail.com  SMTP_PASS=<16-character app password>
# Check the settings with:  npm run test-mail -w server -- you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FixNest <no-reply@example.com>
# Where the built web app lives (npm run build). Served by this server when NODE_ENV=production.
CLIENT_DIST=../client/dist
NODE_ENV=development
