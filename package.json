{
  "name": "hostel-tracker",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "seed": "npm run seed -w server",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck -w client && npm run build -w server",
    "build": "npm run build -w client",
    "start": "npm start -w server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}
